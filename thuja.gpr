with "bedrock";

library project Thuja is

   type OS_Kind is ("posix", "windows");
   OS : OS_Kind := external ("THUJA_OS", "posix");
   --  Set by Alire from the host system (see alire.toml).

   for Library_Name use "thuja";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "src/" & OS);
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Local_Configuration_Pragmas use "thuja.adc";

      for Default_Switches ("Ada") use
        ("-gnat2022",   --  Ada 2022
         "-gnata",      --  contracts and assertions checked at runtime
         "-gnatwa",     --  all warnings
         "-gnatwe",     --  warnings are errors
         "-gnatVa",     --  all validity checks
         "-gnatyg",     --  GNAT style checks
         "-gnatyM100",  --  ... but 100 columns
         "-g", "-O1");
      for Default_Switches ("C") use ("-Wall", "-Werror", "-g", "-O1");
   end Compiler;

   package Prove is
      --  --no-subprojects: prove thuja, not bedrock.
      for Proof_Switches ("Ada") use ("--level=1", "-j0", "--no-subprojects");
   end Prove;

end Thuja;
